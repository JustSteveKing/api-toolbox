<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Conformance">
            <directory>tests/Conformance</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Memory">
            <directory>tests/Memory</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>tests/Disabled</directory>
            <directory>tests/Override</directory>
            <directory>tests/Options</directory>
            <directory>tests/AppMonitorRoute</directory>
            <directory>tests/Production</directory>
            <directory>tests/Signatures</directory>
        </testsuite>
    </testsuites>
    <php>
        <!--
            The suite peaked at 137M (PHP 8.5) and 125M (PHP 8.3, lowest) on 2026-10-15: past PHP's
            128M default. The growth is the test framework keeping every finished test, not the
            package, which tests/Memory proves boots repeatedly without keeping applications alive.
            256M is twice the peak: room to grow, and still small enough that a leak fails the run.
        -->
        <ini name="memory_limit" value="256M"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
