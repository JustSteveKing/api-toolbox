includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    # Every PHP version the package supports: Laravel 13's floor to 8.5. Code is checked against
    # the whole range, so 8.5-only calls (openssl_sign()'s padding argument) need a version guard.
    phpVersion:
        min: 80300
        max: 80599
    paths:
        - src
        - config
        - stubs
        # Analysed so traits meant for applications are analysed through a real use.
        - tests/Fixtures
        - tools
        - scripts
    # Public constructors check their input at runtime even where the PHPDoc already narrows
    # it, because callers are applications that PHPStan never sees.
    treatPhpDocTypesAsCertain: false
